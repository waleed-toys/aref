import { useState, useEffect } from 'react';
import { ChevronRight, MessageCircle, Phone, MapPin, Clock } from 'lucide-react';

export default function DeliveryTracking() {
  const [deliveryStep, setDeliveryStep] = useState(2);
  const [timeRemaining, setTimeRemaining] = useState(18);
  const [messages, setMessages] = useState([
    { id: 1, text: "السلام عليكم! أنا قريب من المطعم الآن", sender: "driver", time: "2:35 م" },
    { id: 2, text: "تمام، شكراً على الإخبار", sender: "user", time: "2:36 م" }
  ]);
  const [newMessage, setNewMessage] = useState("");
  const [showChatPanel, setShowChatPanel] = useState(false);
  
  // Simulate countdown timer
  useEffect(() => {
    if (timeRemaining > 0) {
      const timer = setTimeout(() => {
        setTimeRemaining(time => time - 1);
      }, 60000); // Update every minute
      return () => clearTimeout(timer);
    }
  }, [timeRemaining]);
  
  // Simulate delivery progress
  useEffect(() => {
    if (deliveryStep < 4) {
      const progressTimer = setTimeout(() => {
        setDeliveryStep(step => step + 1);
      }, 10000); // For demo purposes, progress every 10 seconds
      return () => clearTimeout(progressTimer);
    }
  }, [deliveryStep]);
  
  const sendMessage = () => {
    if (newMessage.trim()) {
      const newMsg = {
        id: messages.length + 1,
        text: newMessage,
        sender: "user",
        time: new Date().toLocaleTimeString('ar-KW', { hour: '2-digit', minute: '2-digit' })
      };
      setMessages([...messages, newMsg]);
      setNewMessage("");
      
      // Simulate driver response
      setTimeout(() => {
        const driverResponse = {
          id: messages.length + 2,
          text: "تم استلام الطلب، أنا في الطريق إليك الآن",
          sender: "driver",
          time: new Date().toLocaleTimeString('ar-KW', { hour: '2-digit', minute: '2-digit' })
        };
        setMessages(msgs => [...msgs, driverResponse]);
      }, 3000);
    }
  };
  
  return (
    <div className="min-h-screen bg-gradient-to-b from-purple-50 to-white font-sans" dir="rtl">
      {/* Header */}
      <header className="bg-purple-600 text-white p-4">
        <div className="container mx-auto flex items-center">
          <ChevronRight className="w-6 h-6 cursor-pointer" />
          <h1 className="text-lg font-bold mx-auto">متابعة التوصيل</h1>
        </div>
      </header>
      
      {/* Main Content */}
      <main className="container mx-auto p-4">
        {/* Order Info */}
        <div className="bg-white rounded-lg shadow-md p-4 mb-6">
          <div className="flex justify-between items-center mb-3">
            <div className="font-bold text-lg">طلب #12345</div>
            <div className="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-xs font-bold">
              {deliveryStep === 4 ? "تم التوصيل" : "قيد التوصيل"}
            </div>
          </div>
          
          <div className="flex items-center mb-4">
            <img 
              src="/api/placeholder/60/60" 
              alt="برجر كينج" 
              className="w-10 h-10 object-cover rounded-md" 
            />
            <div className="mr-3">
              <div className="font-bold">برجر كينج</div>
              <div className="text-xs text-gray-500">2 برجر دبل تشيز, 1 بطاطس كبير</div>
            </div>
          </div>
          
          <div className="border-t border-gray-100 pt-3 flex justify-between text-sm">
            <div className="flex items-center text-gray-600">
              <Clock className="w-4 h-4 ml-1" />
              {timeRemaining > 0 ? (
                <span>متبقي {timeRemaining} دقيقة</span>
              ) : (
                <span>جاري التوصيل</span>
              )}
            </div>
            <div className="font-bold">7.500 د.ك</div>
          </div>
        </div>
        
        {/* Delivery Animation */}
        <div className="bg-white rounded-lg shadow-md p-6 mb-6">
          <div className="relative">
            {/* Progress Line */}
            <div className="absolute top-7 left-0 right-0 h-1 bg-gray-200 z-0">
              <div 
                className="h-full bg-purple-600 transition-all duration-1000" 
                style={{ width: `${(deliveryStep / 4) * 100}%` }}
              ></div>
            </div>
            
            {/* Steps */}
            <div className="flex justify-between relative z-10">
              <DeliveryStep 
                title="تأكيد الطلب" 
                icon="🧾" 
                active={true} 
                completed={deliveryStep > 1} 
              />
              
              <DeliveryStep 
                title="تجهيز الطلب" 
                icon="👨‍🍳" 
                active={deliveryStep >= 2} 
                completed={deliveryStep > 2} 
                animating={deliveryStep === 2}
              />
              
              <DeliveryStep 
                title="في الطريق" 
                icon="🛵" 
                active={deliveryStep >= 3} 
                completed={deliveryStep > 3} 
                animating={deliveryStep === 3}
              />
              
              <DeliveryStep 
                title="تم التوصيل" 
                icon="🎉" 
                active={deliveryStep >= 4} 
                completed={deliveryStep === 4} 
                animating={deliveryStep === 4}
              />
            </div>
          </div>
        </div>
        
        {/* Delivery Person */}
        <div className="bg-white rounded-lg shadow-md p-4 mb-6">
          <div className="text-gray-600 mb-3">مندوب التوصيل</div>
          
          <div className="flex justify-between items-center">
            <div className="flex items-center">
              <div className="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center text-xl">
                👨‍🚀
              </div>
              <div className="mr-3">
                <div className="font-bold">محمد العلي</div>
                <div className="flex items-center text-sm text-yellow-500">
                  ⭐⭐⭐⭐⭐ <span className="text-gray-500 mr-1">4.9</span>
                </div>
              </div>
            </div>
            
            <div className="flex gap-2">
              <button className="w-10 h-10 bg-green-100 text-green-600 rounded-full flex items-center justify-center" onClick={() => window.alert('جاري الاتصال بالمندوب...')}>
                <Phone className="w-5 h-5" />
              </button>
              
              <button 
                className="w-10 h-10 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center"
                onClick={() => setShowChatPanel(!showChatPanel)}
              >
                <MessageCircle className="w-5 h-5" />
              </button>
            </div>
          </div>
        </div>
        
        {/* Delivery Location */}
        <div className="bg-white rounded-lg shadow-md p-4 overflow-hidden">
          <div className="flex items-center text-gray-600 mb-3">
            <MapPin className="w-5 h-5 ml-1" />
            <span>موقع التوصيل</span>
          </div>
          
          <div className="bg-gray-100 h-40 rounded-lg flex items-center justify-center">
            <div className="text-center text-gray-500">
              <div className="text-4xl mb-2">🗺️</div>
              <div>خريطة الموقع</div>
            </div>
          </div>
          
          <div className="mt-3 text-sm text-gray-600">
            الصديق، قطعة 5، شارع 10، منزل 20
          </div>
        </div>
      </main>
      
      {/* Chat Panel */}
      {showChatPanel && (
        <div className="fixed inset-0 bg-black bg-opacity-50 z-40 flex justify-center items-end">
          <div className="bg-white rounded-t-xl w-full max-w-md h-3/4 flex flex-col">
            <div className="p-4 border-b border-gray-200 flex justify-between items-center">
              <h3 className="font-bold">دردشة مع المندوب</h3>
              <button 
                className="text-gray-500" 
                onClick={() => setShowChatPanel(false)}
              >
                إغلاق
              </button>
            </div>
            
            <div className="flex-1 overflow-y-auto p-4">
              {messages.map(msg => (
                <div 
                  key={msg.id} 
                  className={`mb-4 flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}
                >
                  <div className={`max-w-xs rounded-lg p-3 ${
                    msg.sender === 'user' 
                      ? 'bg-purple-600 text-white rounded-tr-none' 
                      : 'bg-gray-100 text-gray-800 rounded-tl-none'
                  }`}>
                    <div className="text-sm">{msg.text}</div>
                    <div className={`text-xs mt-1 ${
                      msg.sender === 'user' ? 'text-purple-200' : 'text-gray-500'
                    }`}>
                      {msg.time}
                    </div>
                  </div>
                </div>
              ))}
            </div>
            
            <div className="p-3 border-t border-gray-200">
              <div className="flex">
                <input 
                  type="text" 
                  value={newMessage}
                  onChange={(e) => setNewMessage(e.target.value)}
                  className="flex-1 border border-gray-300 rounded-lg pl-4 pr-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-400"
                  placeholder="اكتب رسالتك هنا..."
                  onKeyPress={(e) => e.key === 'Enter' && sendMessage()}
                />
                <button 
                  className="mr-2 bg-purple-600 text-white rounded-lg px-4 py-2"
                  onClick={sendMessage}
                >
                  إرسال
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

// Component for delivery steps
function DeliveryStep({ title, icon, active, completed, animating = false }) {
  return (
    <div className="flex flex-col items-center w-16">
      <div 
        className={`w-14 h-14 rounded-full flex items-center justify-center mb-2 text-xl
          ${active 
            ? completed 
              ? 'bg-purple-600 text-white' 
              : 'bg-purple-500 text-white' 
            : 'bg-gray-200 text-gray-400'
          }
          ${animating ? 'animate-pulse' : ''}
        `}
      >
        {icon}
      </div>
      <div className={`text-xs text-center ${active ? 'font-bold text-purple-800' : 'text-gray-500'}`}>
        {title}
      </div>
    </div>
  );
}
